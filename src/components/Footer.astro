---
import { Image } from 'astro:assets';
import seal from '../images/Mystical Neon Wave Moon Emblem.png';
import { SITE } from '../site.config';
import { getNavPages } from '../lib/lore';

const navPages = await getNavPages();
---

<footer class="site-footer">
  <div class="footer-mark">
    <Image src={seal} alt="" width={44} height={44} class="seal-img" />
    <div>
      <strong>{SITE.title}</strong>
      <span>an original dark-fantasy setting</span>
    </div>
  </div>
  <nav class="footer-links" aria-label="Footer">
    <a href="/lore">Archive</a>
    <a href="/timeline">Timeline</a>
    {navPages.map((p) => <a href={`/${p.id}`}>{p.data.title}</a>)}
  </nav>
  <p class="footer-legal">© {new Date().getFullYear()} {SITE.title}. All rights reserved.</p>
</footer>

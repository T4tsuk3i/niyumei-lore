---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button class:list={['theme-toggle', className]} type="button" data-theme-toggle aria-label="Toggle light and dark theme">
  <!-- moon: shown in light mode -->
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  </svg>
  <!-- sun: shown in dark mode -->
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: light)');

  const apply = (theme: string) => {
    root.dataset.theme = theme;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(theme === 'dark'));
      btn.title = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
    });
  };

  apply(root.dataset.theme === 'light' ? 'light' : 'dark');

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.classList.add('theme-switching');
      apply(next);
      try { localStorage.setItem('theme', next); } catch {}
      setTimeout(() => root.classList.remove('theme-switching'), 400);
    })
  );

  // Follow the OS only until the reader picks a theme themselves.
  media.addEventListener('change', (e) => {
    let stored = null;
    try { stored = localStorage.getItem('theme'); } catch {}
    if (!stored) apply(e.matches ? 'light' : 'dark');
  });
</script>

---
interface Props {
  variant?: 'full' | 'icon';
}
const { variant = 'full' } = Astro.props;
---

<button class:list={['search-trigger', variant]} type="button" data-search-open aria-label="Search the archive">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7" />
    <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
  </svg>
  {variant === 'full' && <span class="search-label">Search the archive</span>}
  {variant === 'full' && <kbd class="search-kbd">/</kbd>}
</button>

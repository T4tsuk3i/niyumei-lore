---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const lore = await getCollection('lore');

// Group lore pages by Age, then sorted by order
const AGE_ORDER = [
  'The First Ocean',
  'The Churning',
  'The Drowning',
  'The Great Forgetting',
  'The Present',
];
const byAge = new Map<string, typeof lore>();
for (const entry of lore) {
  const age = entry.data.age;
  if (!byAge.has(age)) byAge.set(age, []);
  byAge.get(age)!.push(entry);
}
const ages = [...byAge.keys()].sort(
  (a, b) => AGE_ORDER.indexOf(a) - AGE_ORDER.indexOf(b)
);
for (const list of byAge.values()) {
  list.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Niyumei Lore</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <aside class="sidebar">
        <a class="site-title" href="/">NIYUMEI</a>
        <nav>
          <a class="nav-top" href="/lore">The Archive</a>
          <a class="nav-top" href="/timeline">Timeline</a>
          {
            ages.map((age) => (
              <div class="nav-section">
                <span class="nav-section-title">{age}</span>
                {byAge.get(age)!.map((entry) => (
                  <a href={`/lore/${entry.id}`}>{entry.data.title}</a>
                ))}
              </div>
            ))
          }
        </nav>
      </aside>
      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>

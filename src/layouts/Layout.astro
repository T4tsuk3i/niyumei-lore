---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const lore = await getCollection('lore');

// Group lore pages by Age, then sorted by order
const AGE_ORDER = [
  'The First Ocean',
  'The Churning',
  'The Drowning',
  'The Great Forgetting',
  'The Present',
];
const byAge = new Map<string, typeof lore>();
for (const entry of lore) {
  const age = entry.data.age;
  if (!byAge.has(age)) byAge.set(age, []);
  byAge.get(age)!.push(entry);
}
const ages = [...byAge.keys()].sort(
  (a, b) => AGE_ORDER.indexOf(a) - AGE_ORDER.indexOf(b)
);
for (const list of byAge.values()) {
  list.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Niyumei Lore</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/seal.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <aside class="sidebar">
        <a class="site-title" href="/">NIYUMEI</a>
        <span class="site-sub">an archive of the drowned world</span>
        <nav>
          <a class:list={['nav-top', { active: path.startsWith('/lore') }]} href="/lore">
            The Archive
          </a>
          <a class:list={['nav-top', { active: path.startsWith('/timeline') }]} href="/timeline">
            Timeline
          </a>
          {
            ages.map((age) => (
              <div class="nav-section">
                <span class="nav-section-title">{age}</span>
                {byAge.get(age)!.map((entry) => (
                  <a
                    href={`/lore/${entry.id}`}
                    class:list={{ active: path === `/lore/${entry.id}/` || path === `/lore/${entry.id}` }}
                  >
                    {entry.data.title}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>
      </aside>
      <main class="content">
        <slot />
        <footer class="page-footer">
          <img src="/seal.png" alt="" />
          <span>
            Niyumei — an original dark-fantasy setting · All rights reserved ·
            <a href="/">home</a>
          </span>
        </footer>
      </main>
    </div>
  </body>
</html>

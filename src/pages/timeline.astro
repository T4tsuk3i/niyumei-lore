---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('timeline')).sort(
  (a, b) => a.data.era - b.data.era
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Layout title="Timeline">
  <h1>Timeline</h1>
  <p class="description">The memories of the world, in the order they were lost.</p>
  {
    rendered.map(({ entry, Content }) => (
      <div class="timeline-entry">
        <h2>
          {entry.data.link ? (
            <a href={`/lore/${entry.data.link}`}>{entry.data.title}</a>
          ) : (
            entry.data.title
          )}
        </h2>
        {entry.data.summary && <p>{entry.data.summary}</p>}
        {entry.data.link && (
          <p style="margin-top:0.5rem;font-family:var(--sans);font-size:0.75rem;text-transform:uppercase;letter-spacing:0.15em">
            <a href={`/lore/${entry.data.link}`}>read entry →</a>
          </p>
        )}
        <Content />
      </div>
    ))
  }
</Layout>

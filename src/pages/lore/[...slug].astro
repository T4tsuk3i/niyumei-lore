---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lore = await getCollection('lore');
  return lore.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Flat, chronological order across every age → for prev/next
const AGE_ORDER = [
  'The First Ocean',
  'The Churning',
  'The Drowning',
  'The Great Forgetting',
  'The Present',
];
const all = await getCollection('lore');
all.sort(
  (a, b) =>
    AGE_ORDER.indexOf(a.data.age) - AGE_ORDER.indexOf(b.data.age) ||
    (a.data.order ?? 99) - (b.data.order ?? 99)
);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
---

<Layout title={entry.data.title} description={entry.data.description}>
  <h1>{entry.data.title}</h1>
  <p class="meta" style="font-family:var(--sans);text-transform:uppercase;letter-spacing:0.15em;font-size:0.75rem;color:var(--accent-dim);margin-top:-1rem">
    {entry.data.age} · {entry.id.split('/')[0]}
  </p>
  {entry.data.description && <p class="description">{entry.data.description}</p>}
  {
    entry.data.quote && (
      <blockquote class="epigraph">
        “{entry.data.quote}”
        {entry.data.author && <footer style="margin-top:0.5rem;font-size:0.9rem;color:var(--ink-dim)">— {entry.data.author}</footer>}
      </blockquote>
    )
  }
  {
    entry.data.image && (
      <Image
        src={entry.data.image}
        alt={entry.data.title}
        style="width:100%;max-width:42rem;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:8px;margin-bottom:1.5rem"
      />
    )
  }
  <Content />
  <hr />
  <p style="font-size:0.85rem;color:var(--ink-dim);font-family:var(--sans);text-transform:uppercase;letter-spacing:0.12em">
    Category: {entry.data.age} · {entry.id.split('/')[0]}
  </p>
  <nav class="entry-nav" style="display:flex;justify-content:space-between;gap:2rem;margin-top:1rem">
    <div>
      {prev && (
        <a href={`/lore/${prev.id}`}>← {prev.data.title}</a>
      )}
    </div>
    <div style="text-align:right">
      {next && (
        <a href={`/lore/${next.id}`}>{next.data.title} →</a>
      )}
    </div>
  </nav>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lore = await getCollection('lore');
  return lore.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Flat, chronological order across every age → for prev/next
const AGE_ORDER = [
  'The First Ocean',
  'The Churning',
  'The Drowning',
  'The Great Forgetting',
  'The Present',
];
const all = await getCollection('lore');
all.sort(
  (a, b) =>
    AGE_ORDER.indexOf(a.data.age) - AGE_ORDER.indexOf(b.data.age) ||
    (a.data.order ?? 99) - (b.data.order ?? 99)
);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
---

<Layout title={entry.data.title} description={entry.data.description}>
  {
    entry.data.image && (
      <Image class="entry-hero" src={entry.data.image} alt={entry.data.title} />
    )
  }
  <h1>{entry.data.title}</h1>
  <div class="chips">
    <span class="chip age">{entry.data.age}</span>
    <span class="chip">{entry.id.split('/')[0]}</span>
  </div>
  {entry.data.description && <p class="description">{entry.data.description}</p>}
  {
    entry.data.quote && (
      <blockquote class="epigraph">
        “{entry.data.quote}”
        {entry.data.author && <footer>— {entry.data.author}</footer>}
      </blockquote>
    )
  }
  <div class="article-open">
    <Content />
  </div>
  <hr />
  <nav class="entry-nav">
    <div>
      {
        prev ? (
          <a href={`/lore/${prev.id}`} class="prev">
            ← Previous
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <a href="/timeline">
            ← Start of the archive
            <strong>Timeline</strong>
          </a>
        )
      }
    </div>
    <div>
      {
        next ? (
          <a href={`/lore/${next.id}`} class="next">
            Next →
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <a href="/lore" class="next">
            You have reached the present →
            <strong>The Archive</strong>
          </a>
        )
      }
    </div>
  </nav>
</Layout>

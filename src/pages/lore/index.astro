---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import mural from '../../images/Mystical Teal Wave-Ruin Mural.png';

const lore = await getCollection('lore');

const AGE_ORDER = [
  'The First Ocean',
  'The Churning',
  'The Drowning',
  'The Great Forgetting',
  'The Present',
];
const byAge = new Map<string, typeof lore>();
for (const entry of lore) {
  const age = entry.data.age;
  if (!byAge.has(age)) byAge.set(age, []);
  byAge.get(age)!.push(entry);
}
const ages = [...byAge.keys()].sort(
  (a, b) => AGE_ORDER.indexOf(a) - AGE_ORDER.indexOf(b)
);
for (const list of byAge.values()) {
  list.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}
---

<Layout title="The Archive">
  <Image
    src={mural}
    alt="Mural of the Churning"
    style="width:100%;max-width:42rem;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:8px;margin-bottom:2rem"
  />
  <h1>The Archive</h1>
  <p class="description">What remains of the world before the flood.</p>
  {
    ages.map((age) => (
      <section>
        <h2 style="font-variant:small-caps">{age}</h2>
        <ul>
          {byAge.get(age)!.map((entry) => (
            <li>
              <a href={`/lore/${entry.id}`}>{entry.data.title}</a>
              {entry.data.description && ` — ${entry.data.description}`}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>

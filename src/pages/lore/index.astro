---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import mural from '../../images/Mystical Teal Wave-Ruin Mural.png';

const lore = await getCollection('lore');

const sections = new Map<string, typeof lore>();
for (const entry of lore) {
  const section = entry.id.split('/')[0];
  if (!sections.has(section)) sections.set(section, []);
  sections.get(section)!.push(entry);
}
for (const list of sections.values()) {
  list.sort((a, b) => a.data.order - b.data.order);
}
---

<Layout title="The Archive">
  <Image
    src={mural}
    alt="Mural of the Churning"
    style="width:100%;max-width:42rem;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:8px;margin-bottom:2rem"
  />
  <h1>The Archive</h1>
  <p class="description">What remains of the world before the flood.</p>
  {
    [...sections.entries()].map(([section, entries]) => (
      <section>
        <h2 style="text-transform:capitalize">{section}</h2>
        <ul>
          {entries.map((entry) => (
            <li>
              <a href={`/lore/${entry.id}`}>{entry.data.title}</a>
              {entry.data.description && ` — ${entry.data.description}`}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>

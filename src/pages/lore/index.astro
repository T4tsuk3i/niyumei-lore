---
import Layout from '../../layouts/Layout.astro';
import LoreCard from '../../components/LoreCard.astro';
import { Image } from 'astro:assets';
import { getLore, getLoreByAge, sectionKey, sectionName } from '../../lib/lore';
import mural from '../../images/Mystical Teal Wave-Ruin Mural.png';

const ages = await getLoreByAge();
const lore = await getLore();
const sections = [...new Set(lore.map(sectionKey))];
---

<Layout title="The Archive" description="Every recorded fragment of the drowned world, gathered by age." image={mural} wide>
  <header slot="hero" class="page-hero wide">
    <Image src={mural} alt="" widths={[800, 1200, 1600]} quality={72} sizes="(max-width: 900px) 100vw, 75vw" class="page-hero-art" loading="eager" />
    <div class="page-hero-text">
      <p class="eyebrow">{lore.length} fragments · {ages.length} ages</p>
      <h1>The Archive</h1>
      <p class="entry-lede">What remains of the world before the flood, and what grew in its wake.</p>
    </div>
  </header>

  <div class="filter-bar" role="toolbar" aria-label="Filter by section">
    <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">All</button>
    {
      sections.map((s) => (
        <button type="button" class="filter-chip" data-filter={s} aria-pressed="false">
          {sectionName(s)}
        </button>
      ))
    }
  </div>

  {
    ages.map((age) => (
      <section class="age-group" data-age-group>
        <header class="age-group-head">
          <span class="age-group-numeral">{age.numeral}</span>
          <div>
            <h2>{age.name}</h2>
            <p>{age.blurb}</p>
          </div>
        </header>
        <div class="card-grid">
          {age.entries.map((entry) => (
            <LoreCard entry={entry} />
          ))}
        </div>
      </section>
    ))
  }
</Layout>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-age-group]')];

  function apply(filter: string) {
    if (!chips.some((c) => c.dataset.filter === filter)) filter = 'all';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
    cards.forEach((c) => (c.hidden = filter !== 'all' && c.dataset.section !== filter));
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-section]:not([hidden])')));
    const url = new URL(location.href);
    filter === 'all' ? url.searchParams.delete('section') : url.searchParams.set('section', filter);
    history.replaceState(null, '', url);
  }

  chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter!)));
  apply(new URLSearchParams(location.search).get('section') ?? 'all');
</script>

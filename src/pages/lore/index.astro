---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import mural from '../../images/Mystical Teal Wave-Ruin Mural.png';

const lore = await getCollection('lore');

const AGE_ORDER = [
  'The First Ocean',
  'The Churning',
  'The Drowning',
  'The Great Forgetting',
  'The Present',
];
const byAge = new Map<string, typeof lore>();
for (const entry of lore) {
  const age = entry.data.age;
  if (!byAge.has(age)) byAge.set(age, []);
  byAge.get(age)!.push(entry);
}
const ages = [...byAge.keys()].sort(
  (a, b) => AGE_ORDER.indexOf(a) - AGE_ORDER.indexOf(b)
);
for (const list of byAge.values()) {
  list.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}
---

<Layout title="The Archive">
  <Image
    src={mural}
    alt="Mural of the Churning"
    class="entry-hero"
  />
  <h1>The Archive</h1>
  <p class="description">What remains of the world before the flood.</p>
  {
    ages.map((age) => (
      <section>
        <h2>{age}</h2>
        <div class="archive-grid">
          {byAge.get(age)!.map((entry, i) => (
            <a
              href={`/lore/${entry.id}`}
              class="archive-card"
              style={`animation-delay:${0.05 * i}s`}
            >
              {entry.data.image ? (
                <Image src={entry.data.image} alt="" />
              ) : (
                <div
                  style="width:128px;height:84px;border-radius:8px;flex-shrink:0;background:linear-gradient(135deg,#0d1d2e,#14384a)"
                  aria-hidden="true"
                />
              )}
              <div>
                <span class="card-age">{age}</span>
                <h3>{entry.data.title}</h3>
                {entry.data.description && <p>{entry.data.description}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Layout>

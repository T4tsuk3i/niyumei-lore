---
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroImg from '../images/hero.png';
import seal from '../images/Mystical Neon Wave Moon Emblem.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Niyumei — The Churning</title>
    <link rel="icon" type="image/png" href="/seal.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="landing">
      <Image class="landing-bg" src={heroImg} alt="" />
      <div class="landing-inner">
        <Image class="landing-seal" src={seal} alt="Niyumei seal" />
        <h1>THE CHURNING</h1>
        <p class="tagline">
          "The sea did not rise. The world descended into it."
        </p>
        <a class="begin" href="/lore">BEGIN</a>
      </div>
    </div>
  </body>
</html>
